# EXAMPLE ONLY. Replace secrets on the server. NEVER commit a populated .env.cloud.
# Do not copy your local Windows backend/.env to production.
# Database URLs use Docker service names and port 5432.
# For special characters in passwords, percent-encode in DATABASE_URL only.
AUTH_DB_PASSWORD=REPLACE_AUTH_DB_PASSWORD
GITLAB_DB_PASSWORD=REPLACE_GITLAB_DB_PASSWORD
REDMINE_DB_PASSWORD=REPLACE_REDMINE_DB_PASSWORD
ANALYTICS_DB_PASSWORD=REPLACE_ANALYTICS_DB_PASSWORD
AUTH_DATABASE_URL=postgresql+psycopg2://auth_user:REPLACE_AUTH_DB_PASSWORD@auth_db:5432/auth_db
GITLAB_DATABASE_URL=postgresql+psycopg2://gitlab_user:REPLACE_GITLAB_DB_PASSWORD@gitlab_db:5432/gitlab_db
REDMINE_DATABASE_URL=postgresql+psycopg2://redmine_user:REPLACE_REDMINE_DB_PASSWORD@redmine_db:5432/redmine_db
ANALYTICS_DATABASE_URL=postgresql+psycopg2://analytics_user:REPLACE_ANALYTICS_DB_PASSWORD@analytics_db:5432/analytics_db

# Set only on Cloud.ru; redirect must be registered in TPU OAuth.
TPU_CLIENT_ID=REPLACE_TPU_CLIENT_ID
TPU_CLIENT_SECRET=REPLACE_TPU_CLIENT_SECRET
TPU_API_KEY=REPLACE_TPU_API_KEY
TPU_REDIRECT_URI=https://tpu-metrics.duckdns.org/auth/tpu/callback
TPU_FRONTEND_URL=https://tpu-metrics.duckdns.org
TPU_COOKIE_SECURE=true

# Stable Fernet key generated/stored outside Git; don't rotate blindly.
PROJECT_TOKEN_ENCRYPTION_KEY=REPLACE_VALID_FERNET_KEY
# Exact admin-approved PUBLIC hosts only. gitlab.com is built-in.
PROJECT_API_ALLOWED_HOSTS=gitlab.com

# No developer localhost Redmine in Cloud.
REDMINE_URL=
REDMINE_API_KEY=
GITLAB_URL=https://gitlab.com
GITLAB_ACCESS_TOKEN=
KAFKA_BOOTSTRAP_SERVERS=kafka:9094
PROJECT_SYNC_INTERVAL_SECONDS=900
