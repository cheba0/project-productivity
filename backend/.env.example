# Local Docker setup only. Copy to .env, replace EVERY password and OAuth value.
# Never commit .env or send API tokens in chat, issues or logs.
AUTH_DB_PASSWORD=REPLACE_AUTH_PASSWORD
GITLAB_DB_PASSWORD=REPLACE_GITLAB_PASSWORD
REDMINE_DB_PASSWORD=REPLACE_REDMINE_PASSWORD
ANALYTICS_DB_PASSWORD=REPLACE_ANALYTICS_PASSWORD

# Hostnames are Docker Compose service names (NOT localhost).
AUTH_DATABASE_URL=postgresql+psycopg2://auth_user:REPLACE_AUTH_PASSWORD@auth_db:5432/auth_db
GITLAB_DATABASE_URL=postgresql+psycopg2://gitlab_user:REPLACE_GITLAB_PASSWORD@gitlab_db:5432/gitlab_db
REDMINE_DATABASE_URL=postgresql+psycopg2://redmine_user:REPLACE_REDMINE_PASSWORD@redmine_db:5432/redmine_db
ANALYTICS_DATABASE_URL=postgresql+psycopg2://analytics_user:REPLACE_ANALYTICS_PASSWORD@analytics_db:5432/analytics_db

TPU_CLIENT_ID=REPLACE_TPU_CLIENT_ID
TPU_CLIENT_SECRET=REPLACE_TPU_CLIENT_SECRET
TPU_API_KEY=REPLACE_TPU_API_KEY
TPU_REDIRECT_URI=http://localhost:8000/auth/tpu/callback
TPU_FRONTEND_URL=http://localhost:5173
TPU_COOKIE_SECURE=false

# Replace with an actual stable Fernet key; generate once with Python.
PROJECT_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_VALID_FERNET_KEY

# Only verified, publicly accessible HTTPS integration servers; add own Redmine host.
PROJECT_API_ALLOWED_HOSTS=gitlab.com
# Legacy integration producers (not needed for new URL-and-token projects).
GITLAB_URL=https://gitlab.com
GITLAB_ACCESS_TOKEN=
REDMINE_URL=
REDMINE_API_KEY=

KAFKA_BOOTSTRAP_SERVERS=kafka:9094
PROJECT_SYNC_INTERVAL_SECONDS=900
PROJECT_SYNC_POLL_SECONDS=10
